<!--
  Add this block inside <ossec_config> in /var/ossec/etc/ossec.conf on the
  host running ubuntils, then restart the agent:
    systemctl restart wazuh-agent

  No separate decoder install is required: log_format json means Wazuh's
  built-in JSON decoder parses each line, mapping every top-level JSON key
  `k` to `data.k`; local_rules.xml matches directly on those data.* fields.
-->
<localfile>
  <log_format>json</log_format>
  <location>/var/log/ubuntils/wazuh-alerts.json</location>
</localfile>
